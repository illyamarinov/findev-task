{
  "name": "findev-task",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "asc --config asconfig.json --target release",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "prestart": "npm run build:wasm",
    "start": "ng serve",
    "prebuild": "npm run build:wasm && npm run typecheck:worker",
    "build": "ng build",
    "prewatch": "npm run build:wasm",
    "watch": "ng build --watch --configuration development",
    "pretest:wasm": "npm run build:wasm",
    "test:wasm": "node assembly/market-producer.test.mjs",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "imports": {
    "#market/wasm": "./public/market-producer.wasm"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.6.0",
    "assemblyscript": "0.28.20",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
